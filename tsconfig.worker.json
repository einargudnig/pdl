{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "bun"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["worker", "shared", "alchemy.run.ts"]
}
