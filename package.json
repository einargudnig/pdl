{
  "name": "pdl",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply pdl --local",
    "db:migrate:remote": "wrangler d1 migrations apply pdl --remote",
    "db:console": "wrangler d1 execute pdl --local --command",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "lint": "oxlint",
    "check": "oxlint && tsc -b --noEmit && bun run test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "evlog": "^2.13.0",
    "hono": "^4.6.14",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@hono/vite-dev-server": "^0.18.0",
    "@types/bun": "latest",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.4",
    "oxlint": "^1.59.0",
    "prettier": "^3.8.2",
    "typescript": "^7.0.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.4",
    "wrangler": "^3.99.0"
  }
}
